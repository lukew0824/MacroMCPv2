# Copy to .env (gitignored) or export these directly.

# One MCP server process = one MacroMCP user (see server/config.py for why).
MACROMCP_USERNAME=luke

# Defaults to the local Postgres db "macromcp" via unix socket / peer auth.
# Override for a remote/hosted instance.
MACROMCP_DATABASE_URL=postgresql:///macromcp

# --- Auth0 (Phase 4+, not read yet) ---
# Filled in once docs/auth-setup.md Part A is done. Used by server/server.py's
# token_verifier once the MCP server moves from stdio to streamable-http and
# MACROMCP_USERNAME above stops being how identity is resolved.
AUTH0_DOMAIN=
AUTH0_AUDIENCE=
