# Copy to .env (gitignored) or export these directly.

# MACROMCP_TRANSPORT selects which identity mode applies - see
# server/config.py and docs/auth-setup.md Part D.
MACROMCP_TRANSPORT=stdio

# --- stdio mode (default): one process = one user, no auth ---
MACROMCP_USERNAME=luke

# --- streamable-http mode: network-facing, per-request Auth0 auth ---
# Required only when MACROMCP_TRANSPORT=streamable-http. Domain from
# docs/auth-setup.md Part A; audience is that same Part A API Identifier -
# see Part D for why it needs to become a real reachable URL once deployed,
# not stay the .example placeholder.
AUTH0_DOMAIN=
AUTH0_AUDIENCE=

# Defaults to the local Postgres db "macromcp" via unix socket / peer auth.
# Override for a remote/hosted instance.
MACROMCP_DATABASE_URL=postgresql:///macromcp
