# Copy to .env.local (gitignored). From the "MacroMCP Website" Auth0
# Application (Regular Web Application - not the Google Cloud OAuth client,
# and not the MacroMCP API from docs/auth-setup.md Part A).
AUTH0_DOMAIN=dev-ndmm60zhq4alqrtw.us.auth0.com
AUTH0_CLIENT_ID=
AUTH0_CLIENT_SECRET=

# Random 32+ byte secret used to encrypt the session cookie. Generate with:
#   openssl rand -hex 32
AUTH0_SECRET=

APP_BASE_URL=http://localhost:3000

# Same Postgres database server/ (the Python MCP server) uses.
DATABASE_URL=postgresql:///macromcp
